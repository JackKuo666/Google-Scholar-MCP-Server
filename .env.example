# Example environment variables for scholar anti-blocking settings.
# Copy this to .env (do NOT commit your real credentials) and edit as needed.

# Minimum per-host delay in seconds (polite lower bound)
SCHOLAR_MIN_DELAY=3

# Maximum per-host delay in seconds (polite upper bound)
SCHOLAR_MAX_DELAY=8

# How many times to retry on transient errors (network, 429/503/403)
SCHOLAR_MAX_RETRIES=5

# Backoff factor for exponential backoff between retries
SCHOLAR_BACKOFF_FACTOR=2.0

# Whether to rotate the USER-AGENT header (true/false)
SCHOLAR_ROTATE_USER_AGENTS=true

# Optional comma-separated additional user agents to rotate through.
# Example:
# SCHOLAR_USER_AGENTS="UA1,UA2,UA3"
SCHOLAR_USER_AGENTS=

# Optional comma-separated list of HTTP(S) proxies to rotate through.
# Format each proxy like: http://host:port or https://host:port
# Example:
# SCHOLAR_PROXY_LIST="http://10.0.0.1:3128,https://proxy.example:8080"
SCHOLAR_PROXY_LIST=
